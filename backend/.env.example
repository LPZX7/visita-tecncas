PORT=4100
JWT_SECRET=change-me-in-production

# Origens (frontend) extras autorizadas a chamar esta API, separadas por vírgula.
# O próprio domínio que serve o site (self-origin) já é liberado automaticamente —
# só é preciso listar aqui origens ADICIONAIS (ex: um frontend hospedado à parte).
CORS_ORIGIN=http://localhost:5183,http://localhost:3000

# URL pública do frontend — usada para montar o link de aprovação de orçamento no email.
FRONTEND_URL=http://localhost:5183

# Gmail — envio de notificações por email
# 1. Ative a verificação em 2 etapas na conta Gmail que vai enviar os emails.
# 2. Gere uma "senha de app" em: https://myaccount.google.com/apppasswords
# 3. Preencha os dois valores abaixo (a senha de app tem 16 caracteres, sem espaços).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Produção / hospedagem (Render) ---

# String de conexão do Postgres (Supabase, Neon, Render Postgres, etc.)
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# Credenciais do usuário administrador criado automaticamente no primeiro start
# (só é usado quando o banco está vazio). Defina uma senha forte em produção.
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=change-me-in-production
